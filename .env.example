# soroverify-verifier configuration template.
# Copy to .env and adjust; the service reads these from the process environment.
# Required variables will fail boot when unset.

# --- Required ---

# Postgres connection string. The schema is created idempotently at boot.
DATABASE_URL=postgres://postgres:dev@localhost:5432/soroverify

# Soroban RPC endpoint used to fetch deployed wasm bytes.
STELLAR_RPC_URL=https://soroban-mainnet.stellar.org

# --- Identity ---

# base64 PKCS8 DER Ed25519 private key. Generate with:
#   node -e "const {generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
# Unset = an ephemeral identity is generated per boot (verifier_id changes across
# restarts; results still self-verify, but the id is not stable).
# VERIFIER_PRIVATE_KEY=

# --- Build isolation ---

# Comma-separated, digest-pinned build images this service will run. Tag-only
# references are rejected. Empty/unset = fail closed (every build rejected).
# The digest below is an illustrative placeholder (sha256 of "abc") — replace it
# with a real digest you have vetted against the SEP-58 image trust requirements.
# ALLOWED_BUILD_IMAGES=ghcr.io/soroverify/verify@sha256:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# Image used for the source-fetch step (clone/checkout/archive).
VERIFY_IMAGE=soroverify/verify-image:latest

# --- Peers ---

# Comma-separated base URLs of independent verifiers, queried for cross-checks.
# Peer records are only trusted after their signatures verify.
# PEER_VERIFIERS=https://verify-a.example.org,https://verify-b.example.org

# --- Storage / scratch ---

# Content-addressed storage directory for source tarballs.
STORE_DIR=./data

# Scratch directory for fetch/build artifacts.
WORK_DIR=/tmp/soroverify

# --- Resource limits ---

# Wall-clock limit for one rebuild, in ms (container killed on trip).
BUILD_TIMEOUT_MS=600000
# Wall-clock limit for the source fetch, in ms.
FETCH_TIMEOUT_MS=300000
# CPU limit for the build container.
BUILD_CPUS=2
# Memory limit for the build container, in bytes (swap disabled by setting it equal).
BUILD_MEMORY_BYTES=2147483648
# Max processes inside the build container.
BUILD_PIDS_LIMIT=512

# --- Job runner ---

# Max jobs processed at once.
JOB_CONCURRENCY=4

# Service-wide (not per-submitter) ceiling on submissions that are queued or
# running at once, checked before a submission row is even inserted. Distinct
# from JOB_CONCURRENCY, which bounds how many jobs run *simultaneously*:
# without this, a distributed flood of submitters, each individually under
# SUBMISSIONS_RATE_LIMIT_MAX, could still grow the backlog without bound. A
# submission past the ceiling gets a 503 naming the current backlog size, not
# a silent drop.
MAX_ACTIVE_SUBMISSIONS=200

# --- HTTP ---

HOST=0.0.0.0
PORT=8080

# Rate limiting (per source IP). Two tiers: a conservative global default
# applied to every route, and a much stricter limit on POST /submissions
# alone, since every accepted submission triggers a real git clone and an
# isolated container build. The read-only GET /verifications/* and
# /status/:submissionId endpoints deliberately keep the generous global
# default rather than the strict one.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
SUBMISSIONS_RATE_LIMIT_MAX=5
SUBMISSIONS_RATE_LIMIT_WINDOW_MS=60000

# Allowed origins for the public read-only endpoints (GET
# /verifications/:wasmHash, GET /verifications/by-contract/:contractId, GET
# /status/:submissionId). '*' (default) allows any origin; otherwise a
# comma-separated list of exact origins. Only affects those read endpoints —
# POST /submissions is never CORS-enabled. No credentials are ever accepted.
CORS_ALLOWED_ORIGINS=*
